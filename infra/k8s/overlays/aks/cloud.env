# Filled in by .github/workflows/deploy.yml from `terraform output` before `kubectl apply`.
# Placeholders are kept so `kubectl kustomize` works in CI.
GCP_PROJECT_ID=your-gcp-project
CORS_ALLOWED_ORIGINS=https://your-static-web-app.azurestaticapps.net
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_WORKLOAD_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_KEY_VAULT_NAME=your-key-vault
CLOUD_SQL_INSTANCE=your-gcp-project:us-central1:clinic-db
GCP_WIF_AUDIENCE=//iam.googleapis.com/projects/000000000000/locations/global/workloadIdentityPools/aks-pool/providers/aks-oidc
DNS_LABEL=clinic-portal-api
API_HOST=clinic-portal-api.eastus.cloudapp.azure.com
CLINICIAN_EMAILS=
ADMIN_EMAILS=
