# Filled in by .github/workflows/deploy.yml from `terraform output` before `kubectl apply`.
# Placeholders are kept so `kubectl kustomize` works in CI.
AUTH_MODE=dev
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_WORKLOAD_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_KEY_VAULT_NAME=your-key-vault
AZURE_OPENAI_ENDPOINT=https://your-openai.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-5-mini
LAB_STORAGE=azure-blob
LAB_STORAGE_ACCOUNT_URL=https://yourlabs.blob.core.windows.net/
LAB_STORAGE_CONTAINER=lab-reports
LAB_EXTRACTOR=azure-document-intelligence
DOCINTEL_ENDPOINT=https://your-docintel.cognitiveservices.azure.com/
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_TENANT_SUBDOMAIN=yourclinic
ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
DNS_LABEL=clinic-portal
APP_HOST=clinic-portal.canadacentral.cloudapp.azure.com
CLINICIAN_EMAILS=
ADMIN_EMAILS=
