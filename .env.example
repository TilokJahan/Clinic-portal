# Copy to .env and edit. NEVER commit .env.
# These are LOCAL development values only. Real secrets live in Azure Key Vault.

POSTGRES_USER=clinic
POSTGRES_PASSWORD=local_dev_password_change_me
POSTGRES_DB=clinic

# Connection string used by the services (docker-compose network hostname is "db")
DATABASE_URL=postgresql://clinic:local_dev_password_change_me@db:5432/clinic

# Sign-in: "dev" issues demo tokens for the synthetic seed users (local only);
# "entra-external-id" verifies Microsoft Entra External ID tokens (cloud, needs the ENTRA_* values)
AUTH_MODE=dev
# Signs dev tokens. Any random string of 16+ characters; never reuse it anywhere else.
AUTH_DEV_SECRET=local-dev-only-change-me-0123456789

# Where the appointment service reaches the triage service (compose service name)
TRIAGE_SERVICE_URL=http://triage-service:8000

# Triage service: "fake" returns canned results (no cloud needed), "azure-openai" calls Azure OpenAI
TRIAGE_CLIENT=fake
# Needed when TRIAGE_CLIENT=azure-openai. No API key: it signs in with Microsoft Entra ID
# (`az login` locally, workload identity on AKS).
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=gpt-5-mini
# Needed when AUTH_MODE=entra-external-id
ENTRA_TENANT_ID=
ENTRA_TENANT_SUBDOMAIN=
ENTRA_CLIENT_ID=

# Grafana admin password for `docker compose --profile monitoring up` (local only)
GRAFANA_ADMIN_PASSWORD=change-me-locally
